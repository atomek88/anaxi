{
  "description": "Anaxi: show the design-depth status when a session starts in a project with anaxi.json, and (opt-in) the nudges for a doc after Claude edits it.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/after-edit.mjs\"", "timeout": 10 } ] }
    ]
  }
}
